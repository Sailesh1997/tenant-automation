# ─────────────────────────────────────────────────────────
# New Tenant Template — copy and rename this file
# e.g.  environments/storage_outlet_prod.env
#
# Steps to onboard a new tenant:
#   1. Copy this file:  cp tenant_template.env <tenant>.env
#   2. Fill in the 3 tenant identity values below
#   3. Fill in the DB connection credentials
#   4. Run:  python run_tests.py --env <tenant>
#
# Property IDs are auto-discovered — no manual list needed.
# ─────────────────────────────────────────────────────────

# ── Tenant identity (3 values to change per tenant) ──────
CUID=<COMPANY_UID_IN_REDSHIFT>      # e.g. STORSOL, UAT_SANDBOX, STORAGE_OUTLET
MYSQL_SCHEMA=<MYSQL_DATABASE_NAME>  # e.g. hummingbird, hummingbird_storage_outlet_02072025
COMPANY_ID=<MYSQL_COMPANY_ID>       # e.g. 28, 1, 328

# ── MySQL (source) ────────────────────────────────────────
MYSQL_HOST=<MYSQL_HOST>
MYSQL_PORT=3306
MYSQL_USER=<MYSQL_USER>
MYSQL_PASSWORD=<MYSQL_PASSWORD>

# ── Redshift (DLA / TDW) ─────────────────────────────────
REDSHIFT_HOST=<REDSHIFT_HOST>
REDSHIFT_PORT=5439
REDSHIFT_DBNAME=dev
REDSHIFT_USER=<REDSHIFT_USER>
REDSHIFT_PASSWORD=<REDSHIFT_PASSWORD>

# ── Redshift schema names (set to actual schema names for this tenant/env) ───
DLA_SCHEMA=dla
DSA_SCHEMA=dsa
TDW_SCHEMA=tdw

# ── Slack ─────────────────────────────────────────────────
SLACK_WEBHOOK=<SLACK_WEBHOOK_URL>

# ── Optional: test only a subset of properties ────────────
# Remove the # below to override auto-discovery
# PROPERTY_IDS=101,102,103
